{% extends 'base.html.twig' %}

{% block title %}Arbeitszeiten-Tracker{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12">
            <h1 class="mb-3">Arbeitszeiten-Tracker</h1>
            <p class="lead">
                Protokolliere hier deine Arbeitsstunden pro Wochentag und behalte den
                Überblick, wie viel du diese Woche noch arbeiten musst.
            </p>

            <div class="row g-4 my-1">
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">Wochen erfassen</h2>
                            <p class="card-text mb-0">
                                Trage für jeden Wochentag deine Arbeitsstunden ein und lege
                                so viele Wochen an, wie du brauchst.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">Wochenziel im Blick</h2>
                            <p class="card-text mb-0">
                                Der Tracker vergleicht deine erfassten Stunden automatisch mit
                                deinem Wochenziel und zeigt dir den Fortschritt an.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">Immer aktuell</h2>
                            <p class="card-text mb-0">
                                Bereits erfasste Wochen kannst du jederzeit einsehen und
                                nachträglich bearbeiten.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_USER') and week %}
                {% set total = week.totalHours %}
                {% set progress = weeklyTarget > 0 ? (total / weeklyTarget * 100)|round : 0 %}
                {% set dayLabels = {
                    monday: 'Montag', tuesday: 'Dienstag', wednesday: 'Mittwoch',
                    thursday: 'Donnerstag', friday: 'Freitag'
                } %}

                <div class="card my-4">
                    <div class="card-header">Kalenderwoche {{ week.calenderWeek }}</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <span>Erfasst</span>
                            <strong>{{ total }} h</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Wochenziel</span>
                            <strong>{{ weeklyTarget }} h</strong>
                        </div>

                        <div class="progress my-3" role="progressbar"
                             aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar{{ week.targetReached ? ' bg-success' }}"
                                 style="width: {{ progress > 100 ? 100 : progress }}%">{{ progress }}%</div>
                        </div>

                        {% if week.targetReached %}
                            <p class="text-success mb-0">
                                Wochenziel erreicht – {{ total - weeklyTarget }} h über Plan.
                            </p>
                        {% else %}
                            <div class="d-flex justify-content-between">
                                <span>Noch zu arbeiten</span>
                                <strong class="text-danger">{{ week.remainingHours }} h</strong>
                            </div>
                        {% endif %}
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('week.index') }}">Woche ansehen</a>
                        &middot;
                        <a href="{{ path('week.add') }}">Neue Woche erfassen</a>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info my-4">
                    Noch keine Woche erfasst.
                    <a href="{{ path('week.add') }}" class="alert-link">Jetzt die erste Woche anlegen</a>.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
