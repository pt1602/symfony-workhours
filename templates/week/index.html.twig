{% extends 'base.html.twig' %}

{% block title %}Kalenderwoche {{ week.calenderWeek|default('–') }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% if week %}
                {% set target = weeklyTarget %}
                {% set hours = week.workHours ?? {} %}
                {% set progress = target > 0 ? (week.totalHours / target * 100)|round : 0 %}
                {% set dayLabels = {
                    monday: 'Montag', tuesday: 'Dienstag', wednesday: 'Mittwoch',
                    thursday: 'Donnerstag', friday: 'Freitag'
                } %}

                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                    <h1 class="mb-0">Kalenderwoche {{ week.calenderWeek }}</h1>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('week.edit') }}">Bearbeiten</a>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                {% for key, label in dayLabels %}
                                    {% set value = hours[key]|default(0) %}
                                    <tr{{ value <= 0 ? ' class="text-body-secondary"' }}>
                                        <th scope="row" class="fw-normal">{{ label }}</th>
                                        <td class="text-end">{{ value > 0 ? value ~ ' h' : '(' ~ dailyDefaults[loop.index0] ~ ' h)' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="border-top">
                                <tr>
                                    <th scope="row">Summe</th>
                                    <td class="text-end fw-bold">{{ week.totalHours }} h</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <span>Wochenziel</span>
                        <span>{{ week.totalHours }} / {{ target }} h</span>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" role="progressbar"
                             aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar{{ week.targetReached ? ' bg-success' }}"
                                 style="width: {{ progress > 100 ? 100 : progress }}%">{{ progress }}%</div>
                        </div>

                        {% if week.targetReached %}
                            <p class="text-success mb-0">
                                Wochenziel erreicht – {{ week.totalHours - target }} h über Plan.
                            </p>
                        {% else %}
                            <p class="mb-1">
                                Noch zu arbeiten:
                                <strong class="text-danger">{{ week.remainingHours }} h</strong>
                            </p>
                            {% if week.forecastPerOpenWorkday is not null %}
                                <p class="text-body-secondary mb-1 mt-2">Vorausschau je offenem Tag:</p>
                                <ul class="text-body-secondary mb-0">
                                    {% for day, hoursForecast in week.forecastPerOpenWorkday %}
                                        <li>{{ dayLabels[day] }}: {{ hoursForecast|number_format(1, ',', '.') }} h</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    Derzeit keine Woche angelegt.
                    <a href="{{ path('week.add') }}" class="alert-link">Jetzt eine Woche erfassen</a>.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
